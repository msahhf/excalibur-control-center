#!/bin/sh
set -e
if [ "$1" = remove ]; then
    # Version derived from the installed source dir, not hard-coded.
    for src in /usr/src/excalibur-wmi-*/; do
        [ -f "$src/dkms.conf" ] || continue
        version="$(basename "$src")"
        version="${version#excalibur-wmi-}"
        dkms remove -m excalibur-wmi -v "$version" --all >/dev/null 2>&1 || true
    done
fi
#DEBHELPER#
exit 0
