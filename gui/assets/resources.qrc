<RCC>
    <!-- Application icon embedded into the binary, so the window/tray icon never
         depends on an installed theme or an absolute filesystem path. The PNGs
         themselves are the same files installed under share/icons/hicolor. -->
    <qresource prefix="/icons">
        <file alias="excalibur-control-center-16.png">icons/hicolor/16x16/apps/excalibur-control-center.png</file>
        <file alias="excalibur-control-center-24.png">icons/hicolor/24x24/apps/excalibur-control-center.png</file>
        <file alias="excalibur-control-center-32.png">icons/hicolor/32x32/apps/excalibur-control-center.png</file>
        <file alias="excalibur-control-center-48.png">icons/hicolor/48x48/apps/excalibur-control-center.png</file>
        <file alias="excalibur-control-center-64.png">icons/hicolor/64x64/apps/excalibur-control-center.png</file>
        <file alias="excalibur-control-center-128.png">icons/hicolor/128x128/apps/excalibur-control-center.png</file>
        <file alias="excalibur-control-center-256.png">icons/hicolor/256x256/apps/excalibur-control-center.png</file>
    </qresource>
</RCC>
